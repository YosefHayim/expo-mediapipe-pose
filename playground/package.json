{
	"name": "pose-playground",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build:assets": "node scripts/assets.mjs",
		"dev": "pnpm build:assets && vite --host 127.0.0.1",
		"build": "pnpm --dir .. build && pnpm build:assets && tsc --noEmit && vite build",
		"prod": "pnpm build && vite preview --host 127.0.0.1",
		"typecheck": "pnpm --dir .. build && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "1.2.2",
		"expo-mediapipe-pose": "workspace:*",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "1.65.0",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "6.0.3",
		"vite": "8.3.7",
		"vitest": "5.1.0"
	}
}
