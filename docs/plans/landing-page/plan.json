            "id": "topScreen",
            "kind": "screen",
            "x": 20,
            "y": 20,
            "w": 700,
            "h": 780,
            "html": "<div class='sk-browser-window w-full'><div class='sk-browser-url'>yosefhayim.github.io/expo-mediapipe-pose</div><nav class='sk-header-navigation' data-part='siteNav'><span class='font-bold'>expo-mediapipe-pose</span><div class='flex gap-1'><a class='sk-header-navigation-link'>Playground</a><a class='sk-header-navigation-link'>Features</a><a class='sk-header-navigation-link'>Agents</a><a class='sk-header-navigation-link'>FAQ</a><a class='sk-header-navigation-link'>GitHub</a></div><button type='button' class='sk-toggle' data-part='themeToggle'>Dark</button></nav><div class='grid grid-cols-2 items-center gap-6 p-6'><div class='space-y-3'><h2 class='sk-heading text-3xl'>Body tracking for Expo.<br><span class='opacity-50'>On the phone, in real time.</span></h2><p>33 body points from the camera, a photo or a video. Native MediaPipe, no server.</p><div class='sk-tabs sk-segmented' data-part='audienceTabs'><span class='sk-tabs-tab' data-status='selected'>For humans</span><span class='sk-tabs-tab'>For agents</span></div><div class='sk-code-snippet' data-part='installCommand'><p>npx expo install expo-mediapipe-pose</p></div><div class='flex gap-3'><button type='button' class='sk-button sk-main' data-part='tryLive'>Try it live</button><button type='button' class='sk-button'>Read the docs</button></div></div><div class='sk-video-player relative h-72 w-full' data-percent='40' data-part='heroClip'><p class='absolute start-3 top-3 text-sm'>A person moving, skeleton drawn on top</p></div></div><div class='space-y-3 p-6' data-part='playground'><h3 class='sk-heading text-xl'>Playground</h3><div class='sk-tabs'><span class='sk-tabs-tab' data-status='selected'>Camera</span><span class='sk-tabs-tab'>Photo</span><span class='sk-tabs-tab'>Video</span></div><div class='grid grid-cols-3 gap-3'><div class='sk-card col-span-2 h-36 p-3'><p>Preview with skeleton and mask</p></div><div class='sk-card h-36 p-3'><p>Controls, rules and the matching code</p></div></div></div></div>"
          }
        ],
