{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"src/index.ts",
				"src/core.ts",
				"src/**/*.test.ts",
				"src/testing/*.ts"
			]
		},
		"playground": {
			"includeEntryExports": true,
			"entry": [
				"src/main.tsx",
				"src/**/*.test.ts",
				"e2e/*.spec.ts",
				"scripts/assets.mjs"
			]
		}
	}
}
