{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"example/*.ts",
			"example/*.tsx",
			"example/*.json",
			"scripts/*.mjs",
			"*.json",
			"playground/src/**",
			"playground/tests/**",
			"playground/*.ts",
			"playground/*.json",
			"playground/scripts/*.mjs"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
