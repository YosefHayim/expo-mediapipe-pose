{
	"name": "expo-mediapipe-pose",
	"version": "0.3.0",
	"description": "On-device pose camera for Expo with customizable skeletons, named landmarks, and pose feedback rules.",
	"main": "build/index.js",
	"types": "build/index.d.ts",
	"files": [
		"build",
		"src",
		"ios/*.swift",
		"android/src/main",
		"android/build.gradle",
		"assets",
		"ExpoMediaPipePose.podspec",
		"expo-module.config.json",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md",
		"llms.txt",
		"CHANGELOG.md"
	],
	"scripts": {
		"dev": "pnpm --filter pose-playground dev",
		"prod": "pnpm --filter pose-playground prod",
		"build": "tsc -p tsconfig.build.json",
		"test": "tsx --test tests/*.test.ts",
		"test:watch": "tsx --test --watch tests/*.test.ts",
		"test:swift": "mkdir -p scripts/dev && xcrun swiftc ios/PoseFrameTiming.swift tests/native/FrameTimingTests.swift -o scripts/dev/frame-timing-tests && scripts/dev/frame-timing-tests",
		"lint": "biome check . && knip",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"check": "turbo run lint typecheck test build --output-logs=errors-only",
		"verify:package": "node scripts/verify-package.mjs",
		"prepack": "pnpm build",
		"prepare": "husky && pnpm build"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/YosefHayim/expo-mediapipe-pose.git"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"peerDependencies": {
		"effect": "^3.21.4",
		"expo": "^57.0.0",
		"react": "^19.2.0",
		"react-native": "^0.86.0",
		"react-native-svg": "^15.15.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/jsdom": "27.0.0",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"husky": "9.1.7",
		"jsdom": "27.4.0",
		"knip": "6.44.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-native-svg": "15.16.1",
		"tsx": "4.23.15",
		"turbo": "2.11.10",
		"typescript": "5.9.3"
	},
	"author": "Yosef Hayim Sabag",
	"packageManager": "pnpm@10.34.9",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"default": "./build/index.js"
		},
		"./core": {
			"types": "./build/core.d.ts",
			"default": "./build/core.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"expo",
		"react-native",
		"mediapipe",
		"pose-detection",
		"pose-estimation",
		"camera",
		"skeleton-tracking"
	],
	"homepage": "https://github.com/YosefHayim/expo-mediapipe-pose#readme",
	"bugs": {
		"url": "https://github.com/YosefHayim/expo-mediapipe-pose/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
